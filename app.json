{
	"expo": {
		"name": "Instant Connect",
		"slug": "instant-connect-client",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "instantconnectclient",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/expo.icon",
			"bundleIdentifier": "com.tolagenius.instantconnect",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"package": "com.tolagenius.instantconnect",
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"permissions": [
				"android.permission.USE_BIOMETRIC",
				"android.permission.USE_FINGERPRINT",
				"android.permission.ACCESS_COARSE_LOCATION",
				"android.permission.ACCESS_FINE_LOCATION"
			]
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#EC4899",
					"dark": {
						"backgroundColor": "#EC4899"
					}
				}
			],
			[
				"expo-local-authentication",
				{
					"faceIDPermission": "Allow $(PRODUCT_NAME) to unlock your account with Face ID."
				}
			],
			[
				"expo-location",
				{
					"locationWhenInUsePermission": "Your location will be used to discover events and people near you."
				}
			],
			"expo-maps"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "5b14349b-2b18-40e6-a3ff-4c1f2ac904e5"
			}
		},
		"owner": "tolagenius",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/5b14349b-2b18-40e6-a3ff-4c1f2ac904e5"
		}
	}
}
