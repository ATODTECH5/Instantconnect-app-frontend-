# Android Google Maps key, read by app.config.ts and written into the Android
# manifest at build time. iOS uses Apple Maps and needs no key.
# Create one in the Google Cloud console with the "Maps SDK for Android" enabled,
# then restrict it to this app's package name and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=

# Base URL of the Instant Connect API, including the /api/v1 prefix.
# Leave it unset in development and the app derives it from the Metro host, which
# is what a simulator or a real device needs since localhost resolves to the
# phone itself. Set it explicitly for staging, production, or a tunnel.
# EXPO_PUBLIC_API_URL=https://api.instantconnect.app/api/v1
